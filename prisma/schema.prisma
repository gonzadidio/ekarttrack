generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pilot {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  Booking[]
  lapTimes  LapTime[]
}

model Kart {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String
  status    KartStatus @default(AVAILABLE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions  Session[]
}

enum KartStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

model TurnType {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  durationMin  Int
  defaultPrice Float
  maxPilots    Int      @default(10)
  color        String?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  features     String?  // JSON array string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     Session[]
}

model Session {
  id         String        @id @default(cuid())
  date       DateTime
  startTime  String
  endTime    String
  maxPilots  Int           @default(10)
  price      Float
  status     SessionStatus @default(OPEN)
  turnType   TurnType?     @relation(fields: [turnTypeId], references: [id])
  turnTypeId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  bookings  Booking[]
  lapTimes  LapTime[]
  kart      Kart?    @relation(fields: [kartId], references: [id])
  kartId    String?
}

enum SessionStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Booking {
  id           String        @id @default(cuid())
  pilot        Pilot         @relation(fields: [pilotId], references: [id])
  pilotId      String
  session      Session       @relation(fields: [sessionId], references: [id])
  sessionId    String
  participants Int           @default(1)
  status       BookingStatus @default(PENDING)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([pilotId, sessionId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model LapTime {
  id        String   @id @default(cuid())
  pilot     Pilot    @relation(fields: [pilotId], references: [id])
  pilotId   String
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
  lapNumber Int
  time      Float
  createdAt DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model BusinessHours {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique // 0=Domingo ... 6=Sábado
  isOpen    Boolean @default(true)
  openTime  String? // "10:00"
  closeTime String? // "23:00"
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  isClosed  Boolean  @default(true)
  openTime  String?
  closeTime String?
  createdAt DateTime @default(now())
}
